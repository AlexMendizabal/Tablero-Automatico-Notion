# Token de la integración interna de Notion (Settings > Connections > Develop or manage integrations).
NOTION_TOKEN=

# ID de la base de Notion (32 caracteres hexadecimales, o la URL completa de la base).
NOTION_TABLERO_DB_ID=

# Opcional: carpeta con los documentos ODD, relativa a la raíz del repositorio. Por defecto "odd/tasks".
TABLERO_CARPETA=

# Opcional: rama base para el enlace "Documento" de cada fila (la rama por defecto del repositorio). Por defecto "main".
TABLERO_RAMA_BASE=
