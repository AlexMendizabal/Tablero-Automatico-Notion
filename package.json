  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Sincroniza el estado de tus features (documentos ODD en odd/tasks/*.md) hacia un tablero de Notion.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexMendizabal/Tablero-Automatico-Notion.git"
  },
