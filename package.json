  },
  "homepage": "https://github.com/AlexMendizabal/Tablero-Automatico-Notion#readme",
  "keywords": [
    "notion",
    "github",
    "kanban",
    "project-management",
    "odd",
    "automation",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "tsx src/sync-tablero-features.ts",
