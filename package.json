{
  "name": "tablero-automatico-notion",
  "version": "1.1.0",
  "type": "commonjs",
  "description": "Sync the status of your features and tasks (ODD documents in odd/tasks/*.md and odd/tareas/*.md) to a Notion board.",
  "bin": {
    "tablero-notion": "dist/entrypoints/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE",
    "CHANGELOG.md",
    "skill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexMendizabal/Tablero-Automatico-Notion.git"
  },
  "bugs": {
    "url": "https://github.com/AlexMendizabal/Tablero-Automatico-Notion/issues"
  },
  "homepage": "https://github.com/AlexMendizabal/Tablero-Automatico-Notion#readme",
  "keywords": [
    "notion",
    "github",
    "kanban",
    "project-management",
    "odd",
    "automation",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "sync": "tsx src/entrypoints/cli.ts",
    "sync:dry": "tsx src/entrypoints/cli.ts --dry-run",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^18.0.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
